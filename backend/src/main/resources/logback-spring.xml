<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback config. Two profiles:
   - default (dev):  plain-text, colourised via Spring Boot defaults.
   - json (prod):    single-line pseudo-JSON pattern — no extra deps, works for Loki/CloudWatch
                     ingestion that parses string-field layouts.
  Activate the JSON variant via `SPRING_PROFILES_ACTIVE=json` or `-Dspring.profiles.active=json`.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- DEV: plain text with Spring Boot's default colour pattern -->
    <springProfile name="!json">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!--
      PROD: one JSON-shaped line per event. Uses logback's built-in pattern-layout escaping —
      %replace with a regex scrubs literal double-quotes out of the message so the output is
      still valid JSON. No extra libraries required.
    -->
    <springProfile name="json">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>{"ts":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC}","level":"%level","thread":"%thread","logger":"%logger","msg":"%replace(%msg){'\"','\\\\"'}","traceId":"%X{traceId:-}","spanId":"%X{spanId:-}","ex":"%replace(%rEx{10}){'\"','\\\\"'}"}%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
