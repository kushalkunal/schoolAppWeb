# SchoolApp web admin — env template. Copy to .env.local and fill in.
# All NEXT_PUBLIC_* vars are bundled into the client JS, so don't put secrets there.

# ---------------- Backend ----------------
# No trailing slash. Default dev value points at docker compose.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Signup channel — must match the backend's app.signup.channel.
# PHONE | EMAIL | BOTH
NEXT_PUBLIC_SIGNUP_CHANNEL=PHONE

# ---------------- White-label branding ----------------
# Set these per-school deploy. Defaults in src/brand/branding.config.ts apply when blank.

# School identity
NEXT_PUBLIC_BRAND_SCHOOL_NAME=Springfield Public School
NEXT_PUBLIC_BRAND_SHORT_NAME=Springfield
NEXT_PUBLIC_BRAND_TAGLINE=Where curiosity meets character.
NEXT_PUBLIC_BRAND_AFFILIATION=Affiliated to CBSE

# Visual assets (URLs or /public/* paths)
NEXT_PUBLIC_BRAND_LOGO=/brand/logo.svg
NEXT_PUBLIC_BRAND_LOGO_DARK=/brand/logo-dark.svg
NEXT_PUBLIC_BRAND_FAVICON=/favicon.svg
NEXT_PUBLIC_BRAND_LOGIN_HERO=

# Brand palette — primary drives CTAs, accent drives highlights / badges.
NEXT_PUBLIC_BRAND_PRIMARY=#4f46e5
NEXT_PUBLIC_BRAND_ACCENT=#10b981
NEXT_PUBLIC_BRAND_RADIUS=0.625rem

# Contact block printed on receipts + TCs + bonafide + hall tickets.
NEXT_PUBLIC_BRAND_PHONE=
NEXT_PUBLIC_BRAND_EMAIL=
NEXT_PUBLIC_BRAND_ADDRESS=
NEXT_PUBLIC_BRAND_WEBSITE=

# GSTIN goes on every fee receipt. Leave blank if your school isn't GST-registered.
NEXT_PUBLIC_BRAND_GSTIN=

# Social links — footer of /login + parent app.
NEXT_PUBLIC_BRAND_FACEBOOK=
NEXT_PUBLIC_BRAND_INSTAGRAM=
NEXT_PUBLIC_BRAND_YOUTUBE=
NEXT_PUBLIC_BRAND_X=
